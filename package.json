{
  "name": "execution-os",
  "private": true,
  "version": "1.0.0",
  "description": "Execution OS - a personal 24-hour command system",
  "author": "Pragyesh Jain",
  "type": "module",
  "main": "build/electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:web": "vite build",
    "build:node": "node scripts/build-node.mjs",
    "build": "npm run build:web && npm run build:node",
    "serve": "node build/server.cjs",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "electron": "npm run build && electron .",
    "dist:exe": "npm run build && electron-builder --config electron-builder.config.cjs --win portable nsis --x64",
    "android:sync": "npm run build:web && npx cap sync android",
    "dist:apk": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragyesh85-SPT/execution-os.git"
  },
  "keywords": [
    "productivity",
    "time-blocking",
    "focus",
    "offline-first",
    "local-first",
    "electron",
    "capacitor",
    "react",
    "sqlite"
  ]
}
